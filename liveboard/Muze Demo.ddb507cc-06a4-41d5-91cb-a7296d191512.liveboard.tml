        name: diff
        expr: "[formula_upper] - [formula_lower]"
        was_auto_generated: false
      - id: formula_diff_
        name: diff_
        expr: "moving_sum ( [sales] , 1 , - 1 , month ( [date] ) )"
        was_auto_generated: false
      - id: formula_lower
        name: lower
        expr: "if ( month_number ( [date] ) = group_max ( month_number ( [date] ) ) ) then 0 else cumulative_sum ( [sales] , month ( [date] ) ) - sum ( [sales] )"
        was_auto_generated: false
      - id: formula_typee
        name: typee
        expr: "if ( month_number ( [date] ) = group_max ( month_number ( [date] ) ) or month_number ( [date] ) = group_min ( month_number ( [date] ) ) ) then 'total' else if ( sum ( [sales] ) > moving_sum ( [sales] , 1 , - 1 , month ( [date] ) ) ) then 'increase' else if ( sum ( [sales] ) < moving_sum ( [sales] , 1 , - 1 , month ( [date] ) ) ) then 'decrease' else 'total'"
        was_auto_generated: false
      - id: formula_upper
        name: upper
        expr: "cumulative_sum ( [sales] , month ( [date] ) )"
        was_auto_generated: false
      - id: formula_md
