        was_auto_generated: false
      - id: formula_sales_end
        name: sales_end
        expr: "sum ( if ( [date] = add_days ( start_of_month ( add_months ( [date] , 1 ) ) , - 1 ) ) then [sales] else 0 )"
        was_auto_generated: false
      - id: formula_sales_start
        name: sales_start
        expr: "sum ( if ( [date] = start_of_month ( [date] ) ) then [sales] else 0 )"
        was_auto_generated: false
